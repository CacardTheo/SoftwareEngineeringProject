<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySaveWpf.ViewModels"
        x:Class="EasySaveWpf.Views.SettingsWindow"
        Title="{Binding LangMgr[gui_settings_title]}"
        Width="480" Height="500"
        MinWidth="380" MinHeight="400"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <DockPanel Margin="24">

    <TextBlock DockPanel.Dock="Top" Text="{Binding LangMgr[gui_settings_title]}" FontSize="20" FontWeight="Bold"
               Foreground="#CDD6F4" Margin="0,0,0,20"/>

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="10">
            <Button Content="{Binding LangMgr[gui_cancel]}" Command="{Binding CancelCommand}"
              Background="#313150" Foreground="#CDD6F4" Padding="16,8" CornerRadius="4"/>
            <Button Content="{Binding LangMgr[gui_save]}" Command="{Binding SaveCommand}"
              Background="#4A90D9" Foreground="White" Padding="16,8" CornerRadius="4"/>
    </StackPanel>

    <!-- Form -->
    <ScrollViewer>
      <StackPanel Spacing="14">

        <!-- Language -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LanguageSelectorLabel}" Foreground="#9399B2" FontSize="12"/>
          <ComboBox ItemsSource="{Binding AvailableLanguages}"
                    SelectedItem="{Binding Language}"
                    Background="#2A2A3E" Foreground="#CDD6F4" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Log format -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_log_format]}" Foreground="#9399B2" FontSize="12"/>
          <ComboBox ItemsSource="{Binding AvailableFormats}"
                    SelectedItem="{Binding LogFormat}"
                    Background="#2A2A3E" Foreground="#CDD6F4" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- State format -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_state_format]}" Foreground="#9399B2" FontSize="12"/>
          <ComboBox ItemsSource="{Binding AvailableFormats}"
                    SelectedItem="{Binding StateFormat}"
                    Background="#2A2A3E" Foreground="#CDD6F4" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Business software processes -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_business_processes]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding BusinessProcesses}"
                   AcceptsReturn="True" Height="80"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <!-- Encrypted extensions -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_encrypted_extensions]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding EncryptedExtensions}"
                   AcceptsReturn="True" Height="80"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>


        <!-- Prioritized extensions -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_prioritized_extensions]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding PrioritizedExtensions}"
                   AcceptsReturn="True" Height="80"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <!-- Large file size threshold -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_large_file_threshold]}" Foreground="#9399B2" FontSize="12"/>
          <NumericUpDown Value="{Binding LargeFileSizeThresholdKb}"
                         Minimum="0" Increment="1024"
                         Background="#2A2A3E" Foreground="#CDD6F4"
                         BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <!-- Encryption key -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_encryption_key]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding EncryptionKey}"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
