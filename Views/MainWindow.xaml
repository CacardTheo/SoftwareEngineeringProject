<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasySaveWpf.Views.MainWindow"
        Width="800" Height="450"
        Title="EasySave">
  <StackPanel Orientation="Vertical" Background="#2D2D30">
    <Button Content="{Binding MenuCreateText}" Command="{Binding CreateJobCommand}" />
    <Button Content="{Binding MenuRunAllText}" Command="{Binding RunAllJobsCommand}" />
    <ComboBox SelectedItem="{Binding CurrentLanguage}"
              ItemsSource="{Binding AvailableLanguages}" />
  </StackPanel>
</Window>
