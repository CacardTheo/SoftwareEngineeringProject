<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySaveWpf.ViewModels"
        x:Class="EasySaveWpf.Views.AddJobWindow"
        Title="{Binding LangMgr[gui_add_job_title]}"
        Width="460" Height="420"
        MinWidth="360" MinHeight="360"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Grid Margin="24" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="{Binding LangMgr[gui_add_job_title]}" FontSize="20" FontWeight="Bold"
               Foreground="#CDD6F4" Margin="0,0,0,20"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_add_job_name]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding Name}"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_add_job_source]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding SourceDir}"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_add_job_target]}" Foreground="#9399B2" FontSize="12"/>
          <TextBox Text="{Binding TargetDir}"
                   Background="#2A2A3E" Foreground="#CDD6F4"
                   BorderBrush="#3A3A5E" CornerRadius="4" Padding="8"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LangMgr[gui_add_job_type]}" Foreground="#9399B2" FontSize="12"/>
          <ComboBox ItemsSource="{Binding AvailableTypes}"
                    SelectedItem="{Binding SelectedType}"
                    Background="#2A2A3E" Foreground="#CDD6F4"
                    HorizontalAlignment="Stretch"
                    MaxDropDownHeight="120"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="10">
      <Button Content="{Binding LangMgr[gui_cancel]}" Command="{Binding CancelCommand}"
              Background="#313150" Foreground="#CDD6F4" Padding="16,8" CornerRadius="4"/>
      <Button Content="{Binding LangMgr[gui_create]}" Command="{Binding CreateCommand}"
              Background="#4A90D9" Foreground="White" Padding="16,8" CornerRadius="4"/>
    </StackPanel>
  </Grid>
</Window>
