<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Include="**\*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\Languages\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="EasySaveLogServer\**" />
    <Compile Remove="EasySaveLogServer\**" />
    <EmbeddedResource Remove="EasySaveLogServer\**" />
    <None Remove="EasySaveLogServer\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="EasyLog">
      <HintPath>lib\EasyLog.dll</HintPath>
    </Reference>
    <Reference Include="CryptoSoftLib">
      <HintPath>lib\CryptoSoft.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
